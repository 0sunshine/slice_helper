ISLICE_BASE_URL=http://192.168.104.128:8000
# 兼容播种配置；运行后可在“iSlice 与备份”页面维护地址、调度开关和归档 catalog。
# 多实例时使用逗号分隔；第一个地址仍作为旧作业迁移目标。
# ISLICE_BASE_URLS=http://192.168.104.128:8000,http://192.168.104.129:8000
PUBLIC_BASE_URL=http://192.168.104.239:8090
HOST=0.0.0.0
PORT=8090
DATA_DIR=./data
TEMP_DIR=./temp
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
MAX_ACTIVE_JOBS=15
POLL_INTERVAL_SECONDS=15
PIPELINE_PROGRESS_THRESHOLD=71
WINDOW_TIMEOUT_SECONDS=21600
FFMPEG_TIMEOUT_SECONDS=7200
# 可选：Fernet 密钥。未配置时首次启动会生成 DATA_DIR/service-credential.key。
# SERVICE_CREDENTIAL_KEY=replace-with-fernet-key
